# ==========================================
# CONFIGURACIÓN PARA VERCEL (FRONTEND)
# ==========================================
# En el panel de Vercel (Project Settings -> Environment Variables), añade:
# La URL de tu backend HTTPS activo (servidor propio, Railway, Render, Fly.io o Cloudflare Tunnel)
# Nota: Si omites VITE_WS_URL, el sistema convertirá automáticamente https:// a wss://
VITE_BACKEND_URL=https://tu-backend-produccion.com

# Opcional (si tu servidor WebSocket usa un dominio o puerto diferente):
# VITE_WS_URL=wss://tu-backend-produccion.com

# ==========================================
# CONFIGURACIÓN DEL BACKEND (NODE / EXPRESS)
# ==========================================
PORT=3001
NODE_ENV=production

# Orígenes CORS permitidos adicionales separados por coma (opcional, *.vercel.app ya está incluido por defecto)
# ALLOWED_ORIGINS=https://mi-dominio-personalizado.com
